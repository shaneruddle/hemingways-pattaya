rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- PRIMITIVES ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    
    function isAdmin() { 
      return isSignedIn() && (
        (request.auth.token.email.lower() == "info@hemingwayspattaya.com") ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );
    }
    
    // Monthly Summary owner — email only, deliberately not role-based.
    function isShane() {
      return isSignedIn() && request.auth.token.email.lower() == "shaneruddle@gmail.com";
    }

    function isStaff() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["staff", "cashier", "marketing", "manager"])
      );
    }

    // Owner/manager tier for the Finance dashboard — matches
    // canSeeFinance() in DashboardLayout.tsx and getFinanceRole() in
    // FinanceDashboard.tsx (super_admin -> owner, admin/manager -> manager).
    // Used to gate daily_balances so cashiers can't read/write it.
    function isFinanceLead() {
      return isSignedIn() && (
        (request.auth.token.email.lower() == "info@hemingwayspattaya.com") ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["super_admin", "admin", "manager"])
      );
    }
    
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- ENTITY VALIDATIONS ---

    function isValidMenuItem(data) {
      return data.keys().hasAll(['name', 'category', 'price']) &&
             data.name is string && data.name.size() <= 200 &&
             data.category is string && data.category.size() <= 100 &&
             data.price is string && data.price.size() <= 100 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 2000));
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'order']) &&
             data.name is string && data.name.size() <= 100 &&
             data.order is int;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role', 'uid']) &&
             data.email is string && data.email.size() <= 100 &&
             data.role in ['admin', 'staff', 'user', 'cashier', 'marketing', 'employee', 'admin'] &&
             data.uid == request.auth.uid;
    }

    function isValidMonthlySummaryRow(data) {
      return data.keys().hasAll(['order', 'label', 'balance', 'income', 'cogsExpense', 'operatingExpense', 'dividends', 'profit', 'newBalance']) &&
             data.order is number &&
             data.label is string && data.label.size() <= 100 &&
             data.balance is number &&
             data.income is number &&
             data.cogsExpense is number &&
             data.operatingExpense is number &&
             data.dividends is number &&
             data.profit is number &&
             data.newBalance is number;
    }

    function isValidFinanceEntry(data) {
      return data.keys().hasAll(['type', 'amount', 'categoryId', 'date']) &&
             data.type in ['income', 'expense', 'dividend'] &&
             data.amount is number &&
             data.categoryId is string && isValidId(data.categoryId) &&
             data.date is string;
    }

    // --- COLLECTIONS ---

    // PUBLIC DATA (Move to top for easier evaluation)
    match /menu/{itemId} {
      allow get, list: if true;
      allow write: if isStaff();
    }

    match /categories/{categoryId} {
      allow get, list: if true;
      allow write: if isStaff();
    }

    match /specials/{specialId} {
      allow get, list: if true;
      allow write: if isStaff();
    }

    match /sports_schedule/{id} {
      allow get, list: if true;
      allow write: if isStaff();
    }

    match /blog_posts/{postId} {
      allow get, list: if true;
      allow write: if isStaff();
    }

    match /companyProfile/{id} {
      allow get, list: if true;
      allow write: if isStaff();
    }

    match /settings/{settingId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /test/connection {
      allow read: if true;
      allow write: if true;
    }

    // AUTHENTICATED DATA
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming()); 
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && (
        (request.auth.uid == userId && !isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'lastLogin', 'photoURL']) && incoming().role == existing().role) ||
        (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'displayName', 'email', 'photoURL', 'lastLogin']))
      );
    }

    // FINANCE & PAYROLL (ADMIN ONLY)
    match /finance_categories/{id} {
      allow read: if isStaff();
      allow write: if isAdmin() && isValidId(id);
    }

    match /finance_entries/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && isValidId(id) && isValidFinanceEntry(incoming());
      allow update: if isStaff() && incoming().diff(existing()).affectedKeys().hasOnly(['amount', 'categoryId', 'categoryName', 'description', 'date']);
      allow delete: if isAdmin();
    }

    // NEW FINANCE MODULE
    match /finance_expenses/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isStaff() && incoming().diff(existing()).affectedKeys().hasOnly(['total', 'category_id', 'category_name', 'notes']);
      allow delete: if isStaff();
    }

    match /finance_income/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    // Daily Cash/Bank/Shane reconciliation, one doc per trading date. A date
    // stays editable through the following calendar day then locks via
    // lockAt (see DailyBalances.tsx) — owner/manager only, not cashier.
    // The history subcollection is an append-only audit trail of edits.
    match /daily_balances/{date} {
      allow read: if isFinanceLead();
      allow create: if isFinanceLead();
      allow update: if isFinanceLead() && (!('lockAt' in resource.data) || request.time < resource.data.lockAt);
      allow delete: if false;

      match /history/{id} {
        allow read: if isFinanceLead();
        allow create: if isFinanceLead();
        allow update, delete: if false;
      }
    }

    // MONTHLY SUMMARY (shaneruddle@gmail.com ONLY — deliberately narrower than isAdmin())
    match /finance_monthly_summary/{id} {
      allow read: if isShane();
      allow create, update: if isShane() && isValidMonthlySummaryRow(incoming());
      allow delete: if isShane();
    }

    // RECONCILIATIONS (shaneruddle@gmail.com ONLY) — saved counts vs Monthly Summary balances.
    match /finance_reconciliations/{id} {
      allow read, delete: if isShane();
      allow create, update: if isShane() &&
        incoming().keys().hasAll(['monthLabel', 'systemBalance', 'bank', 'cash', 'other', 'float', 'totalCounted', 'difference']) &&
        incoming().monthLabel is string && incoming().systemBalance is number &&
        incoming().bank is number && incoming().cash is number && incoming().other is number &&
        incoming().float is number && incoming().totalCounted is number && incoming().difference is number;
    }

    match /finance_ingredients/{id} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /ingredient_purchases/{id} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /recipes/{id} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /menu_recipes/{id} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /drinks/{id} {
      allow get, list: if true;
      allow write: if isStaff();
    }

    match /employees/{id} {
      allow read: if isStaff();
      allow write: if isAdmin() && isValidId(id);
    }

    match /payroll_summaries/{id} {
      allow read: if isStaff();
      allow write: if isAdmin() && isValidId(id);
    }

    match /loyalty_customers/{id} {
      allow read: if isStaff();
      allow write: if isAdmin() && isValidId(id);
      match /transactions/{txId} {
        allow read: if isStaff();
        allow write: if isAdmin() && isValidId(txId);
      }
    }

    match /system_logs/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidId(id);
    }

    match /contact_submissions/{id} {
      allow create: if true; // anyone can submit contact form
      allow read: if isAdmin();
    }

        // --- GLOBAL SAFETY NET (MOVED TO BOTTOM) ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
